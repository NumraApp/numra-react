# Installed, not authored. The lockfile is what pins the tree; node_modules is
# a build product of it.
node_modules/

# `npm pack` output. Committing one means the next reader cannot tell which
# tarball was actually published.
*.tgz

# npm's own noise.
npm-debug.log*
.npm/

# Editor and OS droppings that have no business in a published repo.
.DS_Store
*.swp

# test/RiskBadge.test.js compiles RiskBadge.jsx to a real file so Node can
# import it — the compiled output resolves 'react' by name, so a data: URL will
# not do. It is deleted in a finally, but a crash between the two leaves one
# behind, and committing a stale compile would let it pass the test.
test/.compiled-*.js
